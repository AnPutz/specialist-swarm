{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wichtel-Team",
  "type": "object",
  "required": ["rfp_aspekte", "wichtel"],
  "additionalProperties": false,
  "properties": {
    "rfp_aspekte": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "wichtel": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "rolle", "faehigkeiten"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rolle": { "type": "string", "minLength": 1 },
          "faehigkeiten": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
